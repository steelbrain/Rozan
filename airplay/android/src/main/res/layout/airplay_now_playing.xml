<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:paddingStart="@dimen/airplay_edge"
    android:paddingEnd="@dimen/airplay_edge">

    <ImageView
        android:id="@+id/airplay_now_playing_artwork"
        android:layout_width="@dimen/airplay_artwork"
        android:layout_height="@dimen/airplay_artwork"
        android:background="@color/airplay_surface"
        android:contentDescription="@string/airplay_artwork_description"
        android:scaleType="centerCrop" />

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="48dp"
        android:layout_weight="1"
        android:orientation="vertical">

        <!-- Two lines: the sender's name is the point, and translations put more words before it. -->
        <TextView
            android:id="@+id/airplay_now_playing_source"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:maxLines="2"
            android:textColor="@color/airplay_text_secondary"
            android:textSize="@dimen/airplay_text_label" />

        <TextView
            android:id="@+id/airplay_now_playing_title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:ellipsize="end"
            android:maxLines="2"
            android:textColor="@color/airplay_text_primary"
            android:textSize="@dimen/airplay_text_title" />

        <TextView
            android:id="@+id/airplay_now_playing_artist"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:ellipsize="end"
            android:singleLine="true"
            android:textColor="@color/airplay_text_primary"
            android:textSize="@dimen/airplay_text_subtitle" />

        <TextView
            android:id="@+id/airplay_now_playing_album"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:ellipsize="end"
            android:singleLine="true"
            android:textColor="@color/airplay_text_secondary"
            android:textSize="@dimen/airplay_text_subtitle" />
    </LinearLayout>
</LinearLayout>
