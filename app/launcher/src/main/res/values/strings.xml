    <!-- Home button redirect (accessibility service) -->
    <string name="redirect_service_label">Rozan home button</string>
    <string name="redirect_service_description">Opens Rozan when the Home button shows the stock home screen. It reads only which app\'s screen is in front and acts only on the stock home screen itself, never on Settings, panels or other apps. It does not read or block keys.</string>

    <plurals name="minutes">
