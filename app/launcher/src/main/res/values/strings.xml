    <!-- In the three details below, %1$s is redirect_service_label as the system's accessibility settings show it. -->
    <string name="settings_home_button_on_detail">The \"%1$s\" accessibility service opens Rozan whenever the stock home screen appears. It never acts on Settings or other system screens.</string>
    <string name="settings_home_button_not_running_detail">The system lists \"%1$s\" as turned on but has not started it. Turn it off and on again in the system\'s accessibility settings, or run the adb commands below.</string>
    <string name="settings_home_button_off_detail">Home opens the stock home screen. To open Rozan instead, turn on \"%1$s\" in the system\'s accessibility settings. Where there is no such setting (Fire TV on Fire OS 8.1.5.5 or later), run these on a computer with adb:</string>
    <string name="settings_home_button_none_summary">Home opens a screen that Rozan does not replace, such as setup or the system\'s app chooser.</string>
    <string name="settings_home_button_unrecognized">Not in Rozan\'s list of known home screens: %1$s</string>
    <string name="settings_home_button_adb_note">Replace LIST with what the first command prints. If it prints null, leave out LIST and the colon after it.</string>
    <string name="settings_open_stock_home">Open the stock home screen</string>
    <string name="settings_open_stock_home_summary">Stays there until you open another app</string>
