<?xml version="1.0" encoding="utf-8"?>
<!--
  docs/research/home-button-override.md, 6.3. Window state changes only; the
  interactive windows flag and window content let the service read which
  window is active; no package filter (it must see other apps come to the
  front); no debounce; no key filtering.
-->
<accessibility-service xmlns:android="http://schemas.android.com/apk/res/android"
    android:accessibilityEventTypes="typeWindowStateChanged"
    android:accessibilityFeedbackType="feedbackGeneric"
    android:accessibilityFlags="flagRetrieveInteractiveWindows"
    android:canRequestFilterKeyEvents="false"
    android:canRetrieveWindowContent="true"
    android:description="@string/redirect_service_description"
    android:notificationTimeout="0"
    android:settingsActivity="ai.aneesiqbal.rozan.launcher.RedirectSettingsActivity" />
