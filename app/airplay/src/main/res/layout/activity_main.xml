<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="@dimen/edge"
        android:paddingTop="@dimen/top"
        android:paddingEnd="@dimen/edge"
        android:paddingBottom="@dimen/top">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/app_name"
            android:textColor="@color/text_secondary"
            android:textSize="@dimen/text_label" />

        <TextView
            android:id="@+id/receiver_name"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:ellipsize="end"
            android:singleLine="true"
            android:textColor="@color/text_primary"
            android:textSize="@dimen/text_title" />

        <TextView
            android:id="@+id/status"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:drawablePadding="12dp"
            android:gravity="center_vertical"
            android:textColor="@color/text_primary"
            android:textSize="@dimen/text_body" />

        <LinearLayout
            android:id="@+id/row_enabled"
            style="@style/Row"
            android:layout_marginTop="28dp">

            <TextView
                style="@style/RowLabel"
                android:text="@string/row_enabled" />

            <TextView
                android:id="@+id/value_enabled"
                style="@style/RowValue" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/row_wake"
            style="@style/Row"
            android:layout_marginTop="4dp">

            <TextView
                style="@style/RowLabel"
                android:text="@string/row_wake" />

            <TextView
                android:id="@+id/value_wake"
                style="@style/RowValue" />
        </LinearLayout>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/row_padding"
            android:layout_marginTop="4dp"
            android:maxWidth="@dimen/row_width"
            android:text="@string/row_wake_hint"
            android:textColor="@color/text_secondary"
            android:textSize="@dimen/text_hint" />

        <LinearLayout
            style="@style/Row"
            android:layout_marginTop="8dp"
            android:focusable="false">

            <TextView
                android:id="@+id/label_name"
                style="@style/RowLabel"
                android:labelFor="@+id/edit_name"
                android:text="@string/row_name" />

            <EditText
                android:id="@+id/edit_name"
                android:layout_width="400dp"
                android:layout_height="wrap_content"
                android:background="@drawable/field"
                android:imeOptions="actionDone|flagNoExtractUi"
                android:importantForAutofill="no"
                android:inputType="textCapWords|textNoSuggestions"
                android:maxLength="63"
                android:paddingHorizontal="12dp"
                android:paddingVertical="6dp"
                android:singleLine="true"
                android:textColor="@color/text_primary"
                android:textCursorDrawable="@null"
                android:textSize="@dimen/text_body" />
        </LinearLayout>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/row_padding"
            android:layout_marginTop="24dp"
            android:text="@string/overlay_title"
            android:textColor="@color/text_secondary"
            android:textSize="@dimen/text_label" />

        <TextView
            android:id="@+id/overlay_state"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/row_padding"
            android:layout_marginTop="4dp"
            android:maxWidth="@dimen/row_width"
            android:textColor="@color/text_primary"
            android:textSize="@dimen/text_body" />

        <TextView
            android:id="@+id/overlay_command"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/row_padding"
            android:layout_marginTop="12dp"
            android:background="@color/surface"
            android:fontFamily="monospace"
            android:paddingHorizontal="16dp"
            android:paddingVertical="10dp"
            android:textColor="@color/text_primary"
            android:textIsSelectable="false"
            android:textSize="@dimen/text_code" />
    </LinearLayout>
</ScrollView>
