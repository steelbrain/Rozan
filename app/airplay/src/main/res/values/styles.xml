<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Theme.RozanAirPlay" parent="android:Theme.DeviceDefault.NoActionBar">
        <item name="android:windowBackground">@color/background</item>
        <item name="android:colorAccent">@color/accent</item>
        <item name="android:textColorHighlight">@color/accent_dim</item>
    </style>

    <style name="Row">
        <item name="android:layout_width">@dimen/row_width</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:minHeight">@dimen/row_height</item>
        <item name="android:orientation">horizontal</item>
        <item name="android:gravity">center_vertical</item>
        <item name="android:paddingStart">@dimen/row_padding</item>
        <item name="android:paddingEnd">@dimen/row_padding</item>
        <item name="android:background">@drawable/row</item>
        <item name="android:focusable">true</item>
        <item name="android:clickable">true</item>
    </style>

    <style name="RowLabel">
        <item name="android:layout_width">0dp</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_weight">1</item>
        <item name="android:textColor">@color/text_primary</item>
        <item name="android:textSize">@dimen/text_body</item>
    </style>

    <style name="RowValue">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:textColor">@color/text_secondary</item>
        <item name="android:textSize">@dimen/text_body</item>
    </style>
</resources>
