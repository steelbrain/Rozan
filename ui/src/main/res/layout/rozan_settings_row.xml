<?xml version="1.0" encoding="utf-8"?>
<merge xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    tools:orientation="horizontal"
    tools:parentTag="android.widget.LinearLayout">

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:duplicateParentState="true"
        android:orientation="vertical">

        <TextView
            android:id="@+id/rozan_row_title"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:duplicateParentState="true"
            android:textAlignment="viewStart"
            android:textColor="@color/rozan_row_title"
            android:textSize="@dimen/rozan_row_title_text" />

        <TextView
            android:id="@+id/rozan_row_summary"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:duplicateParentState="true"
            android:ellipsize="end"
            android:maxLines="2"
            android:textAlignment="viewStart"
            android:textColor="@color/rozan_row_summary"
            android:textSize="@dimen/rozan_row_summary_text"
            android:visibility="gone" />
    </LinearLayout>

    <TextView
        android:id="@+id/rozan_row_value"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/rozan_row_value_gap"
        android:duplicateParentState="true"
        android:maxLines="1"
        android:textColor="@color/rozan_row_summary"
        android:textSize="@dimen/rozan_row_title_text"
        android:visibility="gone" />

    <ai.aneesiqbal.rozan.ui.ToggleView
        android:id="@+id/rozan_row_toggle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/rozan_row_value_gap"
        android:duplicateParentState="true"
        android:visibility="gone" />
</merge>
