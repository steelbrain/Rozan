<?xml version="1.0" encoding="utf-8"?>
<merge xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    tools:orientation="horizontal"
    tools:parentTag="android.widget.LinearLayout">

    <ImageView
        android:id="@+id/rozan_warning_icon"
        android:layout_width="@dimen/rozan_warning_icon"
        android:layout_height="@dimen/rozan_warning_icon"
        android:layout_marginEnd="@dimen/rozan_warning_icon_gap"
        android:duplicateParentState="true"
        android:importantForAccessibility="no"
        android:src="@drawable/rozan_warning_glyph"
        android:tint="@color/rozan_warning_foreground" />

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:duplicateParentState="true"
        android:orientation="vertical">

        <TextView
            android:id="@+id/rozan_warning_title"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:duplicateParentState="true"
            android:fontFamily="sans-serif-medium"
            android:textAlignment="viewStart"
            android:textColor="@color/rozan_warning_foreground"
            android:textSize="@dimen/rozan_row_title_text" />

        <TextView
            android:id="@+id/rozan_warning_summary"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:duplicateParentState="true"
            android:textAlignment="viewStart"
            android:textColor="@color/rozan_warning_summary"
            android:textSize="@dimen/rozan_row_summary_text"
            android:visibility="gone" />
    </LinearLayout>
</merge>
