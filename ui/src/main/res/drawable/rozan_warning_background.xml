<?xml version="1.0" encoding="utf-8"?>
<!-- A warning row: tinted with the warning colour, filled with it when focused. -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_focused="true">
        <shape android:shape="rectangle">
            <solid android:color="@color/rozan_warning" />
            <corners android:radius="@dimen/rozan_row_corner_radius" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <solid android:color="@color/rozan_warning_tint" />
            <corners android:radius="@dimen/rozan_row_corner_radius" />
        </shape>
    </item>
</selector>
